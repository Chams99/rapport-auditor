# Copy to deployment/.env and replace the example with your owned DNS name.
PUBLIC_DOMAIN=auditor.example.org

# Compose mounts this host file as a read-only Docker secret. Keep the file out
# of version control; set it to mode 0400 and owner UID:GID 10001:10001 so the
# unprivileged application can read it without making it world-readable.
RAPPORT_AUDITOR_SECRET_FILE=./secrets/rapport_secret_key
