{
	log default {
		output stdout
		format filter {
			wrap json
			request delete
			request_uri delete
			remote_ip delete
			client_ip delete
		}
	}
	servers {
		timeouts {
			read_body 15s
			read_header 10s
			write 25s
			idle 30s
		}
	}
}

{$PUBLIC_DOMAIN} {
	request_body {
		max_size 1100000
	}

	reverse_proxy app:5000 {
		# Caddy replaces/sets standard forwarded headers and ignores client values by default.
		transport http {
			dial_timeout 2s
			response_header_timeout 12s
			keepalive 20s
		}
		health_uri /api/v1/health/ready
		health_interval 10s
		health_timeout 2s
		health_headers {
			Host {$PUBLIC_DOMAIN}
		}
	}
}
