# Copy only when deployment/.env.traefik does not already exist.
RAPPORT_AUDITOR_PUBLIC_DOMAIN=rapport.chames.tn
RAPPORT_AUDITOR_INGRESS_NETWORK=rapport-auditor-ingress
# The reviewed VPS ingress helper reserves this exact Traefik peer address.
RAPPORT_AUDITOR_TRUSTED_PROXY=172.27.0.2
RAPPORT_AUDITOR_SECRET_FILE=./secrets/rapport_secret_key
# Conservative starting profile for a shared VPS; confirm host headroom before deployment.
RAPPORT_AUDITOR_ANALYSIS_MAX_WORKERS=1
RAPPORT_AUDITOR_APP_MEMORY_LIMIT=1g
RAPPORT_AUDITOR_APP_CPU_LIMIT=1.0
