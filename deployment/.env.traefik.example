# Copy to deployment/.env.traefik and fill in the live network and capacity values.
RAPPORT_AUDITOR_PUBLIC_DOMAIN=rapport.chames.tn
RAPPORT_AUDITOR_INGRESS_NETWORK=rapport-auditor-ingress
# Set this to the fixed address assigned to Traefik on the dedicated internal ingress network.
RAPPORT_AUDITOR_TRUSTED_PROXY=
RAPPORT_AUDITOR_SECRET_FILE=./secrets/rapport_secret_key
# Keep the two-worker baseline unless measured load testing supports a change.
RAPPORT_AUDITOR_ANALYSIS_MAX_WORKERS=2
# These are required. Choose limits only after measuring the shared VPS capacity.
RAPPORT_AUDITOR_APP_MEMORY_LIMIT=
RAPPORT_AUDITOR_APP_CPU_LIMIT=
